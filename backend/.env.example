# Optional LLM Configuration
# Leave blank to use ClauseGuard's Intelligent Heuristic Legal Engine
# Or provide your OpenRouter / OpenAI / Gemini API key:
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM Model (default: openrouter/auto or gpt-4o-mini or gemini-2.0-flash)
LLM_MODEL=google/gemini-2.0-flash-001

# Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Authenticated pilot settings
ALLOW_DEMO=false
# Required only if enabling demo outside run_demo.py; generate a long random secret.
DEMO_SESSION_SECRET=
SUPABASE_URL=
# For legacy HS256 signing. Asymmetric Supabase tokens use JWKS instead.
SUPABASE_JWT_SECRET=
# Optional remote document storage. Never expose in frontend variables.
SUPABASE_SERVICE_KEY=
# Set an absolute path on a persistent disk for customer deployments.
# DATA_DIR=/data
# Comma-separated frontend origins for production CORS.
# ALLOWED_ORIGINS=https://your-frontend.example
